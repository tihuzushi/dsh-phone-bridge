{
  "name": "dsh-phone-bridge",
  "version": "0.4.5",
  "description": "HARNESS Phone: the phone bridge and the mobile shell UI in a single DeepSeek Harness plugin. No extra process, no startup script.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/build.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "android",
    "tailscale",
    "bridge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tihuzushi/dsh-phone-bridge.git"
  },
  "homepage": "https://github.com/tihuzushi/dsh-phone-bridge#readme",
  "bugs": {
    "url": "https://github.com/tihuzushi/dsh-phone-bridge/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
